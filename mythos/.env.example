MYTHOS_ENVIRONMENT=development
MYTHOS_JWT_SIGNING_KEY=replace-with-a-high-entropy-secret
MYTHOS_REFRESH_TOKEN_PEPPER=replace-with-a-different-high-entropy-secret
MYTHOS_FILE_ID_SIGNING_KEY=replace-with-a-third-high-entropy-secret
MYTHOS_PROBLEM_TYPE_BASE_URL=https://api.example.com/problems
MYTHOS_OBJECT_STORE_ENDPOINT=https://rustfs.example
MYTHOS_OBJECT_STORE_REGION=us-east-1
MYTHOS_OBJECT_STORE_BUCKET=mythos
MYTHOS_OBJECT_STORE_ACCESS_KEY=replace-with-rustfs-access-key
MYTHOS_OBJECT_STORE_SECRET_KEY=replace-with-rustfs-secret-key
MYTHOS_OBJECT_STORE_USE_TLS=true
MYTHOS_FILE_CONTENT_URL_TTL_SECONDS=43200
MYTHOS_FILE_CONTENT_CACHE_MAX_AGE_SECONDS=42900
MYTHOS_FILE_DOWNLOAD_URL_TTL_SECONDS=900
