# 出题器后端环境变量示例
# 复制为 server/.env 后按需修改（.env 不应提交到版本库）

# 监听端口
PORT=11453

# JWT 签名密钥（生产环境务必改为随机长字符串）
JWT_SECRET=114514

# 允许的前端来源（desktop_designer dev server 默认 5174）
CORS_ORIGIN=http://localhost:5174

# 启动时自动创建管理员（幂等；也可用 npm run seed-admin 手动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ADMIN_PASSWORD114514
