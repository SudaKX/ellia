# apps/server 运行配置：复制为 .env 生效（.env 不提交）
PORT=3000

# M1 首次启动播种的初始 admin（user/admin 两角色，见 plan-v1.md §7）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# SQLite 数据文件（相对 apps/server 目录；默认 data/ellia.db，已被 gitignore）
DATABASE_PATH=data/ellia.db

# 服务端会话有效期（天）
SESSION_TTL_DAYS=30

# 文件数据目录（UUID→bytes 单层存储；相对 apps/server 目录，已被 gitignore）
FILE_DATA_DIR=data/files

# 单文件上传上限（字节，默认 50 MiB）
MAX_FILE_BYTES=52428800

# 每实体历史快照上限 N（首次建库时写入 app_meta，之后修改本值不生效）
ENTITY_HISTORY_LIMIT=20
