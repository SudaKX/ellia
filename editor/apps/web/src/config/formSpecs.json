{
  "hint": {
    "stable_id": { "type": "string", "description": "稳定 ID，用于在项目内唯一标识该提示。" },
    "source_asset_id": {
      "type": "string",
      "description": "引用的资产实体 resource_id（asset-path:…），提供提示文件内容（后端 Hint.source 必需）。",
      "namespace": "asset-path"
    },
    "download_name": { "type": "string", "description": "下载时展示的文件名（后端必需，单一路径段）。" },
    "display": {
      "type": "object",
      "description": "提示的展示信息。",
      "inner": {
        "title": { "type": "string", "description": "提示标题（后端必需，非空单行）。" },
        "teaser": { "type": "string", "description": "提示摘要。", "optional": true },
        "icon": { "type": "string", "description": "语义化图标 token。", "optional": true },
        "sort_order": { "type": "number", "description": "排序权重，越小越靠前。", "optional": true }
      }
    },
    "credit_id": {
      "type": "string",
      "description": "奖励使用的货币类型 resource_id（credit-id:…）。",
      "namespace": "credit-id"
    },
    "credit_amount": { "type": "number", "description": "奖励数量（后端要求正整数）。" },
    "access_rule_block_id": {
      "type": "string",
      "description": "访问规则 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    }
  },

  "validation": {
    "stable_id": { "type": "string", "description": "稳定 ID。" },
    "validation_id": { "type": "string", "description": "校验器 slug。" },
    "handler_block_id": {
      "type": "string",
      "description": "校验处理 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    }
  },

  "task": {
    "task_id": { "type": "string", "description": "任务 ID。" },
    "dependencies": { "type": "array", "description": "依赖的其他任务 ID。", "item": { "type": "string", "description": "依赖的任务 ID。" } },
    "handler_block_id": {
      "type": "string",
      "description": "任务处理 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    }
  },

  "event-listener": {
    "event_type": { "type": "string", "description": "监听的事件类型。" },
    "priority": { "type": "number", "description": "监听器优先级。" },
    "dependencies": { "type": "array", "description": "依赖的其他监听器/事件。", "item": { "type": "string", "description": "依赖项。" } },
    "listener_block_id": {
      "type": "string",
      "description": "事件监听 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    }
  },

  "achievement": {
    "achievement_id": { "type": "string", "description": "成就 ID。" },
    "secret": { "type": "bool", "description": "是否为隐藏成就。" },
    "display": {
      "type": "object",
      "description": "成就展示信息。",
      "inner": {
        "title": { "type": "string", "description": "成就标题。" },
        "description": { "type": "string", "description": "成就描述。", "optional": true }
      }
    },
    "predicate_block_id": {
      "type": "string",
      "description": "成就判定 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    },
    "reward_block_id": {
      "type": "string",
      "description": "成就奖励 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    }
  },

  "account-template": {
    "account_id": { "type": "string", "description": "虚拟账号 ID。" },
    "display_name": { "type": "string", "description": "账号显示名称。" },
    "permission": { "type": "string", "description": "账号权限标识。" },
    "metadata": { "type": "object", "description": "账号扩展元数据。", "inner": {} }
  },

  "credit-template": {
    "credit_id": { "type": "string", "description": "货币 ID。" },
    "display_name": { "type": "string", "description": "货币显示名称。" },
    "metadata": { "type": "object", "description": "货币扩展元数据。", "inner": {} }
  },

  "artifact-template": {
    "artifact_id": { "type": "string", "description": "模板 ID。" },
    "media_type": { "type": "string", "description": "生成文件的媒体类型。" },
    "download_name": { "type": "string", "description": "下载文件名。", "optional": true },
    "generator_block_id": {
      "type": "string",
      "description": "生成器 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    }
  },

  "artifact-node": {
    "stable_id": { "type": "string", "description": "稳定 ID。" },
    "path": { "type": "string", "description": "节点在文件树中的路径。" },
    "artifact_locator": { "type": "string", "description": "定位生成文件的标识。" },
    "display": {
      "type": "object",
      "description": "节点展示信息。",
      "inner": {
        "label": { "type": "string", "description": "节点显示名称。" },
        "description": { "type": "string", "description": "节点描述。", "optional": true },
        "icon": { "type": "string", "description": "语义化图标 token。", "optional": true },
        "sort_order": { "type": "number", "description": "排序权重。", "optional": true }
      }
    },
    "hidden": { "type": "bool", "description": "是否隐藏。" },
    "download_name": { "type": "string", "description": "下载文件名。", "optional": true },
    "access_rule_block_id": {
      "type": "string",
      "description": "访问规则 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    },
    "node_generator_block_id": {
      "type": "string",
      "description": "节点生成器 Python 代码块 resource_id（python-name:…）。",
      "optional": true,
      "namespace": "python-name"
    }
  }
}
