{
  "hint": {
    "source_asset_id": {
      "type": "ref",
      "description": "引用的资产实体（asset）。",
      "namespace": "asset"
    },
    "download_name": { "type": "string", "description": "下载时展示的文件名（后端必需，单一路径段）。" },
    "display": {
      "type": "object",
      "description": "提示的展示信息。",
      "inner": {
        "title": { "type": "string", "description": "提示标题（后端必需，非空单行）。" },
        "teaser": { "type": "string", "description": "提示摘要。", "optional": true },
        "icon": { "type": "string", "description": "语义化图标 token。", "optional": true },
        "sort_order": { "type": "number", "description": "排序权重，越小越靠前。", "optional": true }
      }
    },
    "credit_id": {
      "type": "ref",
      "description": "购买使用的货币模板实体（credit）。",
      "namespace": "credit"
    },
    "credit_amount": { "type": "number", "description": "货币价格（后端要求正整数）。" },
    "access_rule_block_id": {
      "type": "ref",
      "description": "访问规则 Python 代码块实体（code）。",
      "optional": true,
      "namespace": "code"
    }
  },

  "validation": {
    "validation_id": {
      "type": "string",
      "description": "公开 API slug；1~64 位，仅限字母、数字、下划线、连字符。",
      "format": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "handler_block_id": {
      "type": "ref",
      "description": "校验处理 Python 代码块实体（code）。",
      "namespace": "code"
    }
  },

  "task": {
    "dependencies": {
      "type": "bitflag",
      "description": "任务 handler 需要加载的玩家接口位标志。",
      "enums": [
        "progress",
        "artifacts",
        "accounts",
        "credits",
        "hints",
        "tasks",
        "achievements"
      ]
    },
    "handler_block_id": {
      "type": "ref",
      "description": "任务处理 Python 代码块实体（code）。",
      "namespace": "code"
    }
  },

  "listener": {
    "event_type": {
      "type": "string",
      "description": "监听的事件类型。",
      "options": [
        { "label": "player.constructed", "value": "player.constructed" },
        { "label": "player.deconstructing", "value": "player.deconstructing" },
        { "label": "account.login", "value": "account.login" }
      ]
    },
    "priority": {
      "type": "string",
      "description": "监听器优先级。",
      "options": [
        { "label": "early", "value": "early" },
        { "label": "default", "value": "default" },
        { "label": "late", "value": "late" }
      ]
    },
    "dependencies": {
      "type": "bitflag",
      "description": "事件监听 handler 需要加载的玩家接口位标志。",
      "enums": [
        "progress",
        "artifacts",
        "accounts",
        "credits",
        "hints",
        "tasks",
        "achievements"
      ]
    },
    "listener_block_id": {
      "type": "ref",
      "description": "事件监听 Python 代码块实体（code）。",
      "namespace": "code"
    }
  },

  "achievement": {
    "immediate": {
      "type": "bool",
      "description": "达成后是否立即发放奖励。"
    },
    "meta": {
      "type": "json",
      "description": "成就元数据（title、description 等）。"
    },
    "condition": {
      "type": "ref",
      "description": "成就判定 Python 代码块实体（code）。",
      "optional": true,
      "namespace": "code"
    },
    "effect": {
      "type": "ref",
      "description": "成就奖励 Python 代码块实体（code）。",
      "namespace": "code"
    }
  },

  "account": {
    "display_name": { "type": "string", "description": "账号显示名称。" },
    "permission": { "type": "number", "description": "账号权限标识（整数）。" },
    "metadata": { "type": "json", "description": "账号扩展元数据。" }
  },

  "credit": {
    "display_name": { "type": "string", "description": "货币显示名称。" },
    "metadata": { "type": "json", "description": "货币扩展元数据。" }
  },

  "asset": {
    "source_reference": {
      "type": "ref",
      "description": "引用 source 命名空间下的源文件实体（如 markdown），导出时保存为实际文件并加入 FileReference。",
      "optional": true,
      "namespace": "source"
    },
    "file_reference": {
      "type": "file",
      "description": "引用当前已有的文件。",
      "optional": true
    },
    "media_type": {
      "type": "string",
      "description": "媒体类型。",
      "recommends": [
        "application/octet-stream",
        "text/plain",
        "text/plain; charset=utf-8",
        "text/html",
        "text/css",
        "application/json",
        "application/javascript",
        "application/xml",
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/svg+xml",
        "application/pdf",
        "application/zip",
        "application/x-tar",
        "audio/mpeg",
        "video/mp4"
      ]
    }
  },

  "artifact": {
    "media_type": {
      "type": "string",
      "description": "生成文件的媒体类型。",
      "recommends": [
        "application/octet-stream",
        "text/plain",
        "text/plain; charset=utf-8",
        "text/html",
        "text/css",
        "application/json",
        "application/javascript",
        "application/xml",
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/svg+xml",
        "application/pdf",
        "application/zip",
        "application/x-tar",
        "audio/mpeg",
        "video/mp4"
      ]
    },
    "download_name": { "type": "string", "description": "下载文件名。", "optional": true },
    "generator": {
      "type": "ref",
      "description": "生成器 Python 代码块实体（code）。",
      "optional": true,
      "namespace": "code"
    }
  },

  "artifact-node": {
    "artifact": {
      "type": "ref",
      "description": "关联的 artifact 实体数据源。",
      "namespace": "artifact"
    },
    "display": {
      "type": "object",
      "description": "节点展示信息。",
      "inner": {
        "label": { "type": "string", "description": "节点显示名称。" },
        "description": { "type": "string", "description": "节点描述。", "optional": true },
        "icon": { "type": "string", "description": "语义化图标 token。", "optional": true },
        "sort_order": { "type": "number", "description": "排序权重。", "optional": true }
      }
    },
    "hidden": { "type": "bool", "description": "是否隐藏。" },
    "download_name": { "type": "string", "description": "下载文件名。", "optional": true },
    "access_rule": {
      "type": "ref",
      "description": "访问规则 Python 代码块实体（code）。",
      "optional": true,
      "namespace": "code"
    },
    "node_generator": {
      "type": "ref",
      "description": "节点生成器 Python 代码块实体（code）。",
      "namespace": "code"
    }
  },

  "file-node": {
    "display": {
      "type": "object",
      "description": "节点展示信息。",
      "inner": {
        "label": { "type": "string", "description": "节点显示名称。" },
        "description": { "type": "string", "description": "节点描述。", "optional": true },
        "icon": { "type": "string", "description": "语义化图标 token。", "optional": true },
        "sort_order": { "type": "number", "description": "排序权重。", "optional": true }
      }
    },
    "hidden": { "type": "bool", "description": "是否隐藏。" },
    "download_name": { "type": "string", "description": "下载文件名。", "optional": true },
    "source_asset": {
      "type": "ref",
      "description": "引用的资产实体（asset）。",
      "optional": true,
      "namespace": "asset"
    },
    "access_rule": {
      "type": "ref",
      "description": "访问规则 Python 代码块实体（code）。",
      "optional": true,
      "namespace": "code"
    }
  },

  "progress-node": {
    "how": {
      "type": "ref",
      "description": "branch 目标选择 Python 代码块实体（code）。",
      "optional": true,
      "namespace": "code"
    },
    "mode": {
      "type": "string",
      "description": "merge 合并模式。",
      "optional": true,
      "options": [
        { "label": "and", "value": "and" },
        { "label": "or", "value": "or" }
      ]
    },
    "triggers_checkpoint": {
      "type": "bool",
      "description": "解锁该节点时是否触发 checkpoint。"
    }
  }
}
