{
  "progress-node": {
    "namespace": "pnode",
    "fixed": { "enable": false, "value": "" },
    "default": { "triggers_checkpoint": false },
    "comment": {
      "description": "进度 DAG 节点，可携带可选 how/mode 配置与检查点标记。",
      "format": "kebab-case，例如 start"
    }
  },
  "file-node": {
    "namespace": "inode",
    "fixed": { "enable": false, "value": "" },
    "default": {
      "display": { "label": "File/Directory Name" },
      "hidden": false
    },
    "comment": {
      "description": "静态文件树中的节点，表示目录或文件。",
      "format": "kebab-case，例如 assets"
    }
  },
  "file-tree": {
    "namespace": "file-tree",
    "fixed": { "enable": true, "value": "main" },
    "default": {
      "rootId": "root",
      "nodes": {
        "root": { "id": "root", "name": "/", "isDirectory": true, "inode": null, "parent": null, "order": 0 }
      }
    },
    "comment": {
      "description": "文件树容器，保存根节点与父子排序关系。",
      "format": "固定为 main"
    }
  },
  "dag": {
    "namespace": "dag",
    "fixed": { "enable": true, "value": "main" },
    "default": { "entryIds": [], "nodes": {} },
    "comment": {
      "description": "进度 DAG 容器，保存图内节点与后继关系。",
      "format": "固定为 main"
    }
  },
  "asset": {
    "namespace": "asset",
    "fixed": { "enable": false, "value": "" },
    "default": {
      "source_reference": "",
      "file_reference": "",
      "media_type": "application/octet-stream"
    },
    "comment": {
      "description": "资产引用，可引用文件或 source（至少其一），并声明媒体类型。",
      "format": "kebab-case，例如 readme"
    }
  },
  "hint": {
    "namespace": "hint",
    "fixed": { "enable": false, "value": "" },
    "default": {
      "source_asset_id": "",
      "download_name": "download_name",
      "credit_id": "",
      "credit_amount": 1,
      "display": { "title": "Example Hint" }
    },
    "comment": {
      "description": "提示条目，引用一个资产文件并设置货币奖励与展示信息。",
      "format": "点分 kebab-case，例如 first-hint.basic"
    }
  },
  "script": {
    "namespace": "script",
    "fixed": { "enable": false, "value": "" },
    "default": { "revision": 1, "body": { "kind": "script", "lines": [] } },
    "comment": {
      "description": "终端交互脚本，包含脚本行与可选校验引用。",
      "format": "kebab-case，例如 script-1"
    }
  },
  "markdown": {
    "namespace": "source",
    "fixed": { "enable": false, "value": "" },
    "default": { "sort": [], "segments": {} },
    "comment": {
      "description": "连续 markdown 文本段，导出时作为源文件保存。",
      "format": "kebab-case，例如 guide"
    }
  },
  "questionnaire": {
    "namespace": "source",
    "fixed": { "enable": false, "value": "" },
    "default": { "description": "", "sort": [], "questions": {} },
    "comment": {
      "description": "问卷，包含选择题/填空题，导出时作为源文件保存。",
      "format": "kebab-case，例如 survey"
    }
  },
  "validation": {
    "namespace": "validation",
    "fixed": { "enable": false, "value": "" },
    "default": { "validation_id": "", "handler_block_id": "" },
    "comment": {
      "description": "答案校验条目，关联 handler 代码块。",
      "format": "点分 kebab-case，例如 chapter1.validation.basic-case"
    }
  },
  "artifact": {
    "namespace": "artifact",
    "fixed": { "enable": false, "value": "" },
    "default": { "media_type": "application/octet-stream" },
    "comment": {
      "description": "动态文件模板，通过 generator 生成玩家专属文件。",
      "format": "kebab-case，例如 letter"
    }
  },
  "artifact-node": {
    "namespace": "inode",
    "fixed": { "enable": false, "value": "" },
    "default": {
      "artifact": "",
      "display": { "label": "Artifact Title" },
      "hidden": false,
      "node_generator": ""
    },
    "comment": {
      "description": "动态文件树节点，表示一个可生成的文件节点。",
      "format": "kebab-case，例如 artifact-node-1"
    }
  },
  "account": {
    "namespace": "account",
    "fixed": { "enable": false, "value": "" },
    "default": { "display_name": "", "permission": 0, "metadata": {} },
    "comment": {
      "description": "虚拟账号模板，定义账号展示与权限元数据。",
      "format": "kebab-case，例如 guard"
    }
  },
  "credit": {
    "namespace": "credit",
    "fixed": { "enable": false, "value": "" },
    "default": { "display_name": "", "metadata": {} },
    "comment": {
      "description": "货币类型模板，定义货币展示与元数据。",
      "format": "小写字母/数字开头，可包含 - _ .；例如 vib、test.coins"
    }
  },
  "achievement": {
    "namespace": "achievement",
    "fixed": { "enable": false, "value": "" },
    "default": {
      "immediate": false,
      "meta": {
        "title": "Example Achievement",
        "description": "Example Achievement description"
      },
      "condition": "",
      "effect": ""
    },
    "comment": {
      "description": "成就定义，包含 immediate、meta 与 condition/effect 回调引用。",
      "format": "kebab-case，例如 first-blood"
    }
  },
  "task": {
    "namespace": "task",
    "fixed": { "enable": false, "value": "" },
    "default": { "dependencies": 0, "handler_block_id": "" },
    "comment": {
      "description": "惰性任务定义，包含依赖与 handler 回调引用。",
      "format": "点分 kebab-case，例如 normal.credits.auto-regenerate"
    }
  },
  "listener": {
    "namespace": "listener",
    "fixed": { "enable": false, "value": "" },
    "default": { "event_type": "player.constructed", "priority": "default", "dependencies": 0, "listener_block_id": "" },
    "comment": {
      "description": "事件监听器，监听事件并执行 listener 回调。",
      "format": "点分 kebab-case，例如 event.level-up.early"
    }
  },
  "code": {
    "namespace": "code",
    "fixed": { "enable": false, "value": "" },
    "default": { "content": "" },
    "comment": {
      "description": "Python 代码块，可被其他实体引用为回调函数。",
      "format": "Python 标识符（snake_case），例如 can_access"
    }
  }
}
