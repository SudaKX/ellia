{
  "progress-node": {
    "namespace": "stable-id",
    "fixed": { "enable": false, "value": "" },
    "inject_id": { "enable": true, "field": "stable_id" },
    "default": { "stable_id": "", "node_kind": "normal", "triggers_checkpoint": false },
    "comment": {
      "description": "进度 DAG 中的节点，用于定义普通/分支/合并节点与检查点。",
      "format": "kebab-case，例如 start"
    }
  },
  "file-tree-node": {
    "namespace": "stable-id",
    "fixed": { "enable": false, "value": "" },
    "inject_id": { "enable": true, "field": "stable_id" },
    "default": {
      "stable_id": "",
      "kind": "file",
      "name": "",
      "display": { "label": "", "description": "", "icon": "", "sort_order": 0 },
      "hidden": false
    },
    "comment": {
      "description": "静态文件树中的节点，表示目录或文件。",
      "format": "kebab-case，例如 assets"
    }
  },
  "file-tree": {
    "namespace": "file-tree",
    "fixed": { "enable": true, "value": "main" },
    "inject_id": { "enable": false, "field": "" },
    "default": { "root_stable_id": null, "children": {} },
    "comment": {
      "description": "文件树容器，保存根节点与父子排序关系。",
      "format": "固定为 main"
    }
  },
  "progress-dag": {
    "namespace": "progress-dag",
    "fixed": { "enable": true, "value": "main" },
    "inject_id": { "enable": false, "field": "" },
    "default": { "entry_stable_ids": [], "successors": {} },
    "comment": {
      "description": "进度 DAG 容器，保存入口节点与边关系。",
      "format": "固定为 main"
    }
  },
  "asset": {
    "namespace": "asset-path",
    "fixed": { "enable": false, "value": "" },
    "inject_id": { "enable": false, "field": "" },
    "default": { "file_id": "", "media_type": "application/octet-stream" },
    "comment": {
      "description": "资产文件引用，指向 files 表中的文件并声明媒体类型。",
      "format": "相对路径，例如 assets/a.txt"
    }
  },
  "hint": {
    "namespace": "hint",
    "fixed": { "enable": false, "value": "" },
    "inject_id": { "enable": true, "field": "stable_id" },
    "default": {
      "stable_id": "",
      "credit_id": "vib",
      "credit_amount": 1,
      "display": { "title": "", "teaser": "", "icon": "", "sort_order": 0 }
    },
    "comment": {
      "description": "提示条目，引用一个资产文件并设置货币奖励与展示信息。",
      "format": "点分 kebab-case，例如 first-hint.basic"
    }
  },
  "script": {
    "namespace": "stable-id",
    "fixed": { "enable": false, "value": "" },
    "inject_id": { "enable": true, "field": "stable_id" },
    "default": { "stable_id": "", "revision": 1, "body": { "kind": "script", "lines": [] } },
    "comment": {
      "description": "终端交互脚本，包含脚本行与可选校验引用。",
      "format": "kebab-case，例如 script-1"
    }
  },
  "validation": {
    "namespace": "stable-id",
    "fixed": { "enable": false, "value": "" },
    "inject_id": { "enable": true, "field": "stable_id" },
